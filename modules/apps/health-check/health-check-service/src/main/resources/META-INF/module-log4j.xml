<?xml version="1.0"?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">
	<appender class="org.apache.log4j.rolling.RollingFileAppender" name="TEXT_FILE">
		<rollingPolicy class="org.apache.log4j.rolling.TimeBasedRollingPolicy">
			<param name="ActiveFileName" value="${liferay.home}/logs/health-check.log" />
			<param name="FileNamePattern" value="${liferay.home}/logs/health-check.%d{yyyy-MM-dd}.log" />
		</rollingPolicy>

		<layout class="org.apache.log4j.EnhancedPatternLayout">
			<param name="ConversionPattern" value="%d{ABSOLUTE} %-5p [%t][%c{1}:%L] %m%n" />
		</layout>
	</appender>

	<appender class="org.apache.log4j.rolling.RollingFileAppender" name="XML_FILE">
		<rollingPolicy class="org.apache.log4j.rolling.TimeBasedRollingPolicy">
			<param name="FileNamePattern" value="${liferay.home}/logs/health-check.%d{yyyy-MM-dd}.xml" />
		</rollingPolicy>

		<layout class="org.apache.log4j.xml.XMLLayout">
			<param name="LocationInfo" value="true" />
		</layout>
	</appender>

	<category name="com.liferay.health.check.service.internal.HealthCheckScanner">
		<priority value="INFO" />
	</category>

	<category name="com.liferay.health.check.service.internal.HealthCheckUtil">
		<priority value="INFO" />
	</category>

	<logger name="com.liferay.health.check.service">
		<appender-ref ref="TEXT_FILE" />
		<appender-ref ref="XML_FILE" />
	</logger>
</log4j:configuration>