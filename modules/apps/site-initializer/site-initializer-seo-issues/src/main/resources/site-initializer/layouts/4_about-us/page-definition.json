										}
									}
								},
								{
									"id": "panel-text",
									"value": {
										"fragmentLink": {
										},
										"text": {
											"value_i18n": {
												"en_US": "<ul><li>Founded — 1987, in a Rainier Ave garage</li><li>Home — Portland, Oregon</li><li>Crew — 42 outfitters and techs</li><li>Motto — Carry less. Go farther.</li></ul>"
											}
										}
